+bool RunTransportObserverTest(){
+  for(auto& c:g_observerDownCount)c=0;
+  for(auto& c:g_observerScanNonZero)c=0;
+  g_observerActiveDown=0;g_observerOverlap=0;g_observerReady=false;g_observerThreadId=0;
+  InitBridge();
+  if(g_bridge)InterlockedExchange64(&g_bridge->gameHeartbeatMs,0);
+  HANDLE observer=CreateThread(nullptr,0,TransportObserverThread,nullptr,0,nullptr);
+  if(!observer)return false;
+  for(int i=0;i<200&&!g_observerReady;i++)Sleep(5);
+  if(!g_observerReady){PostThreadMessageW(g_observerThreadId,WM_QUIT,0,0);WaitForSingleObject(observer,1000);CloseHandle(observer);return false;}
+  auto worker=[](LPVOID p)->DWORD{
+    int vk=(int)(INT_PTR)p;
+    for(int i=0;i<24;i++)ReferenceTapKey(vk);
+    return 0;
+  };
+  HANDLE threads[4]{};int keys[4]={'8','9','0','R'};
+  for(int i=0;i<4;i++)threads[i]=CreateThread(nullptr,0,worker,(LPVOID)(INT_PTR)keys[i],0,nullptr);
+  WaitForMultipleObjects(4,threads,TRUE,10000);
+  for(HANDLE h:threads)if(h)CloseHandle(h);
+  Sleep(100);
+  PostThreadMessageW(g_observerThreadId,WM_QUIT,0,0);
+  WaitForSingleObject(observer,2000);CloseHandle(observer);
+  bool scanOk=true,countOk=true;
+  for(int vk:keys){if(g_observerDownCount[vk].load()<=0)countOk=false;if(g_observerScanNonZero[vk].load()!=g_observerDownCount[vk].load())scanOk=false;}
+  std::ofstream out("transport-observer-report.txt");
+  out<<"ObserverReady="<<(g_observerReady?"PASS":"FAIL")<<"\n";
+  out<<"8_Down="<<g_observerDownCount['8'].load()<<"\n";
+  out<<"9_Down="<<g_observerDownCount['9'].load()<<"\n";
+  out<<"0_Down="<<g_observerDownCount['0'].load()<<"\n";
+  out<<"R_Down="<<g_observerDownCount['R'].load()<<"\n";
+  out<<"ScanCodesNonZero="<<(scanOk?"PASS":"FAIL")<<"\n";
+  out<<"Overlap="<<g_observerOverlap.load()<<"\n";
+  bool ok=g_observerReady&&scanOk&&countOk&&g_observerOverlap.load()==0&&g_observerActiveDown.load()==0;
+  out<<"RESULT="<<(ok?"PASS":"FAIL")<<"\n";
+  return ok;
+}
