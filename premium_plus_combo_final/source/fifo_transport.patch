+LRESULT CALLBACK TransportObserverProc(int code,WPARAM wp,LPARAM lp){
+  if(code==HC_ACTION&&(wp==WM_KEYDOWN||wp==WM_SYSKEYDOWN||wp==WM_KEYUP||wp==WM_SYSKEYUP)){
+    auto* k=reinterpret_cast<KBDLLHOOKSTRUCT*>(lp);
+    if(k&&k->dwExtraInfo==kMagicInput){
+      int vk=(int)k->vkCode;
+      if(vk>=0&&vk<256){
+        bool down=wp==WM_KEYDOWN||wp==WM_SYSKEYDOWN;
+        if(down){
+          g_observerDownCount[vk].fetch_add(1);
+          if(k->scanCode)g_observerScanNonZero[vk].fetch_add(1);
+          int prior=g_observerActiveDown.fetch_add(1);
+          if(prior!=0)g_observerOverlap.fetch_add(1);
+        }else{
+          g_observerActiveDown.fetch_sub(1);
+        }
+      }
+    }
+  }
+  return CallNextHookEx(nullptr,code,wp,lp);
+}
+
+DWORD WINAPI TransportObserverThread(LPVOID){
+  g_observerThreadId=GetCurrentThreadId();
+  g_observerHook=SetWindowsHookExW(WH_KEYBOARD_LL,TransportObserverProc,g_instance,0);
+  g_observerReady=(g_observerHook!=nullptr);
+  MSG msg{};
+  while(GetMessageW(&msg,nullptr,0,0)>0){}
+  if(g_observerHook){UnhookWindowsHookEx(g_observerHook);g_observerHook=nullptr;}
+  return 0;
+}
